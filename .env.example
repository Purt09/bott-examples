# Прокси для запросов к Telegram Bot API.
# Если TELEGRAM_PROXY_HOST пустой или переменная отсутствует — запросы идут напрямую.

TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_TYPE=http
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASSWORD=

# TELEGRAM_PROXY_TYPE: http | socks5
# Порты по умолчанию, если TELEGRAM_PROXY_PORT не задан: 64614 (http), 64615 (socks5)
